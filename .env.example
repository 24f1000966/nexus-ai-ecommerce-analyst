# Backend Configuration
# For local development, leave DATABASE_URL empty to use SQLite (data/platform.db)
# For production, set to a Postgres connection string from Neon
DATABASE_URL=postgresql://user:password@host/dbname

# Super Admin Credentials (change in production!)
NEXUS_ADMIN_EMAIL=superadmin@nexusai.in
NEXUS_ADMIN_PASSWORD=YourSecurePassword123!

# Optional: LLM Integration
# Uncomment and set one of these to enable AI-powered text-to-SQL generation
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: Model Configuration
# NEXUS_ANTHROPIC_MODEL=claude-opus-5-5
# NEXUS_OPENAI_MODEL=gpt-4o-mini

# Frontend Configuration
VITE_API_URL=http://localhost:8000
